{
  "name": "automocao_api_cypress",
  "version": "1.0.0",
  "main": "index.js",
   "keywords": [],
  "author": "Paula S Melo ",
  "license": "ISC",
  "description": "",
  "scripts": {
  "test": "cypress open --browser chrome",
  "test:headless": "cypress run --browser chrome --headless",
  "test:report": "npm run test:headless && npm run merge:reports && npm run generate:report",
  "merge:reports": "npx mochawesome-merge cypress/reports/mochawesome*.json > cypress/reports/output.json",
  "generate:report": "npx marge cypress/reports/output.json -f report -o cypress/reports/html",
  "clean:reports": "del /q cypress\\reports\\*.json && del /q cypress\\reports\\html\\*.html && del /q cypress\\reports\\output.json"
},
  "devDependencies": {
    "cypress": "^14.5.2",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.2.0",
    "@shelex/cypress-allure-plugin": "^2.41.2"
  }
}
